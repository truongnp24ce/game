<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/GamePlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_villa_screen"
    android:padding="12dp"
    tools:visibility="visible">

    <!-- Top header bar: pink strip with "Animal Villa" centered and three
         action icons (save / world / megaphone) on the right, matching the
         mockup. -->
    <FrameLayout
        android:id="@+id/headerBar"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_villa_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/animal_villa"
            android:textColor="@color/villa_pink_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconSave"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ic_save_desc"
                android:src="@drawable/ic_villa_save" />

            <ImageView
                android:id="@+id/iconExit"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ic_exit_desc"
                android:src="@drawable/ic_villa_exit" />
        </LinearLayout>
    </FrameLayout>

    <!-- Framed scene illustration. Square-ish frame with a thick pink border,
         filled with the current prompt's character image. -->
    <FrameLayout
        android:id="@+id/imageFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_villa_image_frame"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBar">

        <ImageView
            android:id="@+id/promptImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/prompt_image_desc"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Pink prompt text box -->
    <TextView
        android:id="@+id/promptBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_villa_prompt"
        android:gravity="center"
        android:minHeight="64dp"
        android:padding="10dp"
        android:text="@string/stuff"
        android:textColor="@color/villa_pink_text"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageFrame" />

    <!-- Bottom row: left choice button, three stat tiles (heart / fire /
         dollar), right choice button. -->
    <LinearLayout
        android:id="@+id/bottomRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/promptBox"
        app:layout_constraintVertical_bias="1.0">

        <Button
            android:id="@+id/leftButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.1"
            android:background="@drawable/bg_villa_choice"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:stateListAnimator="@null"
            android:text="@string/leftOption"
            android:textAllCaps="false"
            android:textColor="@color/villa_pink_text"
            android:textSize="12sp"
            tools:ignore="DuplicateSpeakableTextCheck,SpeakableTextPresentCheck" />

        <!-- Stat tiles cluster: heart (energy), fire (status), dollar (money) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statEnergy"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_villa_stat_tile"
                    android:gravity="center"
                    android:text="50"
                    android:textColor="@color/villa_pink_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@string/ic_heart_desc"
                    android:src="@drawable/ic_villa_heart" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statStatus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_villa_stat_tile"
                    android:gravity="center"
                    android:text="50"
                    android:textColor="@color/villa_pink_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@string/ic_fire_desc"
                    android:src="@drawable/ic_villa_fire" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statMoney"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_villa_stat_tile"
                    android:gravity="center"
                    android:text="50"
                    android:textColor="@color/villa_pink_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@string/ic_dollar_desc"
                    android:src="@drawable/ic_villa_dollar" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/rightButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.1"
            android:background="@drawable/bg_villa_choice"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:stateListAnimator="@null"
            android:text="@string/rightOption"
            android:textAllCaps="false"
            android:textColor="@color/villa_pink_text"
            android:textSize="12sp"
            tools:ignore="SpeakableTextPresentCheck" />
    </LinearLayout>

    <!-- "Next Day" button overlays the bottom row when an end-of-day prompt
         is showing (only one of the two button rows is visible at a time). -->
    <Button
        android:id="@+id/nextDayButton"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_villa_choice"
        android:stateListAnimator="@null"
        android:text="@string/nextday"
        android:textAllCaps="false"
        android:textColor="@color/villa_pink_text"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/bottomRow"
        app:layout_constraintEnd_toEndOf="@+id/bottomRow"
        app:layout_constraintStart_toStartOf="@+id/bottomRow"
        app:layout_constraintTop_toTopOf="@+id/bottomRow"
        tools:visibility="invisible" />
</androidx.constraintlayout.widget.ConstraintLayout>
